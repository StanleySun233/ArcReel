# ArcReel Generator Environment Configuration
# ArcReel 生成器环境配置
#
# Copy this file to .env and fill in your values.
# 将此文件复制为 .env 并填入你的配置值。

# ============================================================
# Authentication / 认证配置
# ============================================================
# Auth mode for tenant commercial edition.
# 租户商业版使用 CaMeL 授权登录。
AUTH_MODE=camel
# Login username (default: admin)
# 登录用户名（默认: admin）
# AUTH_USERNAME=admin
# Login password (leave empty to auto-generate on first launch and write back to this file)
# 登录密码（留空则首次启动时自动生成并回写到此文件）
# AUTH_PASSWORD=
# JWT signing secret (leave empty to auto-generate; tokens will invalidate on restart)
# JWT 签名密钥（留空则自动生成，但重启后 token 失效需重新登录）
AUTH_TOKEN_SECRET=
# Auth kill switch (default: true). Set to false to disable login / token checks
# for single-user or trusted-network deployments.
# 认证总开关（默认 true）。设为 false 时跳过登录与 token 校验，适合单机或可信网络部署。
# AUTH_ENABLED=true

# ============================================================
# Network Binding / 网络绑定
# ============================================================
# Defaults preserve current behavior. Override for tighter binding or non-default ports.
# NOTE: LISTEN_HOST / LISTEN_PORT only apply when running via `python server/app.py`
# (the __main__ entrypoint). For `uvicorn server.app:app` / Docker / systemd, pass
# host/port as uvicorn CLI args — the ASGI module cannot rebind uvicorn at import.
# 默认值与当前行为一致；按需收紧绑定地址或端口。
# 注意：LISTEN_HOST / LISTEN_PORT 仅在 `python server/app.py` 入口生效；
# 通过 `uvicorn server.app:app` / Docker / systemd 启动时，请把 host/port 作为
# uvicorn CLI 参数传入（ASGI 模块层无法回头修改 uvicorn 进程的绑定）。
# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=1241
# Comma-separated CORS origins; "*" or unset → permissive (credentials disabled
# by CORS spec). Set an explicit whitelist (e.g. "http://localhost:5173") to
# enable credentialed cross-origin requests.
# 逗号分隔的 CORS 允许 origin；"*" 或不设 → 通配（credentials 因 CORS spec 强制关闭）。
# 设为白名单（如 "http://localhost:5173"）才会开启 credentials 跨域。
# CORS_ORIGINS=*

# ============================================================
# Application Data Root / 应用数据根目录
# ============================================================
# Where local project JSON and non-media local artifacts live. Tenant-edition
# media files are stored through the file table and MinIO.
# 本地 project JSON 与非媒体本地产物根目录。租户版媒体文件走 files 表与 MinIO。
# ARCREEL_DATA_DIR=

# Path to agent_runtime_profile dir (contains .claude/ and CLAUDE.md). Default:
# PROJECT_ROOT/agent_runtime_profile. Set when the profile lives outside the
# source tree so it does not need to be a sibling of the projects root.
# agent_runtime_profile 目录路径（含 .claude/ 与 CLAUDE.md）。不设则默认
# PROJECT_ROOT/agent_runtime_profile；当 profile 不在源码树中、需要独立寻址时配置此项。
# ARCREEL_PROFILE_DIR=

# ============================================================
# Database Configuration / 数据库配置
# ============================================================
# Tenant edition requires PostgreSQL with asyncpg. The app role must not be a
# PostgreSQL superuser and must not have BYPASSRLS.
# 租户版必须使用 PostgreSQL + asyncpg。应用角色不能是 PostgreSQL superuser，
# 也不能拥有 BYPASSRLS。
DATABASE_URL=postgresql+asyncpg://arcreel_app:arcreel_app_dev_password@127.0.0.1:15432/arcreel
# PostgreSQL integration tests use this admin URL only to create isolated schemas
# and temporary roles. Runtime code never reads this variable.
# PostgreSQL 集成测试只用这个 admin URL 创建隔离 schema 和临时 role；运行时代码不读取。
ARCREEL_TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://arcreel:arcreel_dev_password@127.0.0.1:15432/arcreel

# ============================================================
# Redis Configuration / Redis 配置
# ============================================================
# Used for permission cache and later request coordination.
# 用于权限缓存和后续请求协调。
REDIS_URL=redis://127.0.0.1:16379/0

# ============================================================
# File Storage / 文件存储
# ============================================================
# Tenant-edition media storage uses a private MinIO bucket. Frontend access must
# go through backend-issued short signed URLs.
# 租户版媒体存储使用私有 MinIO bucket；前端访问必须走后端短签名 URL。
ARCREEL_MINIO_ENDPOINT=http://127.0.0.1:19000
ARCREEL_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:19000
ARCREEL_MINIO_ACCESS_KEY=arcreelminio
ARCREEL_MINIO_SECRET_KEY=arcreel_minio_dev_password
ARCREEL_MINIO_BUCKET=arcreel-files
ARCREEL_MINIO_REGION=us-east-1
ARCREEL_SIGNED_URL_TTL_SECONDS=300

# ============================================================
# CaMeL OAuth / CaMeL 授权
# ============================================================
# CaMeL-api is an external completed dependency. ArcReel owns tenant,
# membership, permission, and local provider/bootstrap state.
# CaMeL-api 是外部已完成依赖；ArcReel 负责租户、成员、权限和本地 provider/bootstrap 状态。
# CAMEL_OAUTH_BASE_URL=http://localhost:13080
# CAMEL_OAUTH_INTERNAL_BASE_URL=http://localhost:13080
# CAMEL_OAUTH_CLIENT_ID=arc-client
# CAMEL_OAUTH_CLIENT_SECRET=
# CAMEL_OAUTH_REDIRECT_URI=http://localhost:1241/api/v1/auth/camel/callback
# CAMEL_OAUTH_REDIRECT_HOSTS=
# CAMEL_OAUTH_SCOPES=profile email
# CAMEL_OAUTH_BOOTSTRAP_SCOPES=profile email arcreel:token-provision
# CAMEL_OAUTH_REPAIR_MAX_AGE_SECONDS=120

# ============================================================
# Agent Session Store / Agent 会话存储
# ============================================================
# 控制 Claude Agent SDK 会话 transcript 是否镜像入项目数据库（默认 db）。
# 设为 off 可 5 秒回滚到 SDK 自带的本地 jsonl 路径，跳过启动迁移和 DB 镜像。
# Controls whether Claude Agent SDK transcripts are mirrored into the project DB
# (default: db). Set to off to instantly roll back to SDK's filesystem path —
# skips startup migration and the DbSessionStore wiring.
# ARCREEL_SDK_SESSION_STORE=db

# ============================================================
# Logging / 日志配置
# ============================================================
# Log level (default: INFO, options: DEBUG, WARNING, ERROR)
# 日志级别（默认: INFO，可选: DEBUG, WARNING, ERROR）
# LOG_LEVEL=INFO

# Log file directory (default: $PROJECT_ROOT/logs)
# Relative paths resolve against PROJECT_ROOT. Logs intentionally live OUTSIDE
# the projects root (projects/ — the directory enumerated as the list of video
# projects in the UI), so any stray sibling directory would surface as a fake
# project. Note: PROJECT_ROOT is the repo root, projects root = $PROJECT_ROOT/projects.
# 日志文件目录（默认 $PROJECT_ROOT/logs），相对路径基于 PROJECT_ROOT。
# 刻意不放在 projects 目录（视频项目数据根目录）下：该目录会被枚举为视频项目
# 列表，旁系目录会被错认为项目。注意：PROJECT_ROOT 指仓库根，projects 数据
# 根目录则是 $PROJECT_ROOT/projects。
# ARCREEL_LOG_DIR=

# Disable file logging (default: false). When set to 1/true/yes, logs go only to stdout.
# 关闭文件日志（默认 false）。设为 1/true/yes 时日志仅输出到 stdout。
# ARCREEL_LOG_FILE_DISABLED=

# ============================================================
# Timezone / 时区
# ============================================================
# IANA timezone for the container's system clock (used by Docker compose).
# Default: Asia/Shanghai. Common values: Asia/Tokyo, America/Los_Angeles, UTC.
# 容器系统时区（被 docker-compose 注入），默认 Asia/Shanghai。
# 常用值：Asia/Tokyo、America/Los_Angeles、UTC。
# TZ=Asia/Shanghai
