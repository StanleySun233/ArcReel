# ArcReel tenant-edition environment
# Copy to .env and fill in your values.

# ============================================================
# Authentication
# ============================================================
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_TOKEN_SECRET=

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://arcreel_app:change-me@postgres:5432/arcreel

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# MinIO private file storage
# ============================================================
ARCREEL_FILE_STORAGE_BACKEND=minio
ARCREEL_MINIO_ENDPOINT=http://minio:9000
ARCREEL_MINIO_PUBLIC_ENDPOINT=https://files.example.com
ARCREEL_MINIO_ACCESS_KEY=arcreelminio
ARCREEL_MINIO_SECRET_KEY=change-me
ARCREEL_MINIO_BUCKET=arcreel-files
ARCREEL_MINIO_REGION=us-east-1
ARCREEL_SIGNED_URL_TTL_SECONDS=300

# ============================================================
# CaMeL OAuth
# ============================================================
CAMEL_OAUTH_BASE_URL=https://camel.example.com
CAMEL_OAUTH_INTERNAL_BASE_URL=https://camel.example.com
CAMEL_OAUTH_CLIENT_ID=arc-client
CAMEL_OAUTH_CLIENT_SECRET=
CAMEL_OAUTH_REDIRECT_URI=https://arcreel.example.com/api/v1/auth/camel/callback
CAMEL_OAUTH_SCOPES=profile email
CAMEL_OAUTH_BOOTSTRAP_SCOPES=profile email arcreel:token-provision
CAMEL_OAUTH_REPAIR_MAX_AGE_SECONDS=120

CAMEL_ARCREEL_PROVIDER_BASE_URL=https://camel.example.com
CAMEL_ARCREEL_TOKEN_PROVISION_URL=https://camel.example.com/api/oauth/provider/arcreel-tokens
CAMEL_ARCREEL_TOKEN_LINK_TEMPLATE=https://camel.example.com/token/{token_name}
CAMEL_ARCREEL_IMAGE_ENDPOINT=openai-images
CAMEL_ARCREEL_IMAGE_MODELS=camel-image
CAMEL_ARCREEL_TEXT_ENDPOINT=openai-chat
CAMEL_ARCREEL_TEXT_MODELS=camel-text
CAMEL_ARCREEL_VIDEO_ENDPOINT=ark-seedance
CAMEL_ARCREEL_VIDEO_MODELS=doubao-seedance-2-0-260128
CAMEL_ARCREEL_AUDIO_ENDPOINT=openai-tts
CAMEL_ARCREEL_AUDIO_MODELS=camel-audio

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
