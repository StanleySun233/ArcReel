# ArcReel tenant-edition environment
# Copy to .env and fill in your values.

# ============================================================
# Authentication
# ============================================================
AUTH_MODE=camel
AUTH_TOKEN_SECRET=

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://arcreel_app:change-me@postgres:5432/arcreel

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# MinIO private file storage
# ============================================================
ARCREEL_MINIO_ENDPOINT=http://minio:9000
ARCREEL_MINIO_PUBLIC_ENDPOINT=https://files.example.com
ARCREEL_MINIO_ACCESS_KEY=arcreelminio
ARCREEL_MINIO_SECRET_KEY=change-me

# ============================================================
# CaMeL OAuth
# ============================================================
CAMEL_OAUTH_BASE_URL=https://camel.example.com
CAMEL_OAUTH_INTERNAL_BASE_URL=https://camel.example.com
CAMEL_OAUTH_CLIENT_ID=arc-client
CAMEL_OAUTH_CLIENT_SECRET=
CAMEL_OAUTH_REDIRECT_URI=https://arcreel.example.com/api/v1/auth/camel/callback

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
